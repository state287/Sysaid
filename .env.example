# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=helpdesk
DB_PASSWORD=changeme_db
DB_NAME=helpdesk

# ── Admin ──────────────────────────────────────────────────────────────────────
# Password used to access the /admin dashboard
ADMIN_PASSWORD=changeme_admin

# ── Mailgun ────────────────────────────────────────────────────────────────────
# Find these in your Mailgun dashboard → Sending → Domains
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
# "From" address for outbound emails (must be authorised in Mailgun)
MAILGUN_FROM_EMAIL=helpdesk@mg.yourdomain.com

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL of this deployment – used in email links
APP_URL=https://yourdomain.com

# ── Caddy ──────────────────────────────────────────────────────────────────────
# Set to your public domain for automatic HTTPS, or leave as "localhost"
DOMAIN=yourdomain.com
